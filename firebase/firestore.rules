rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Complete profiles are readable by any signed-in user for Discover (W3-01).
    // Incomplete profiles stay owner-only. Email is still on the doc — strip client-side.
    match /users/{userId} {
      allow read: if isOwner(userId)
                  || (isSignedIn() && resource.data.isProfileComplete == true);
      allow write: if isOwner(userId);

      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // FCM tokens for APNs (W3-05). Owner-only — never on the user doc.
      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /preferences/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /prompts/{promptId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /interests/{interestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /promptAnswers/{answerId} {
      function isAnswerOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      function isAnswerOwnerCreate() {
        return isSignedIn()
               && request.resource.data.userId == request.auth.uid;
      }

      function validAnswerFields() {
        return request.resource.data.keys().hasAll(['userId', 'promptId', 'answerText', 'sortOrder'])
               && request.resource.data.userId is string
               && request.resource.data.promptId is string
               && request.resource.data.answerText is string
               && request.resource.data.answerText.size() > 0
               && request.resource.data.answerText.size() <= 150
               && request.resource.data.sortOrder is int;
      }

      allow read: if isSignedIn();
      allow create: if isAnswerOwnerCreate() && validAnswerFields();
      allow update: if isAnswerOwner()
                    && request.resource.data.userId == resource.data.userId
                    && validAnswerFields();
      allow delete: if isAnswerOwner();
    }

    // Discover likes (W3-02). Feed reads outgoing `toUserId`s to exclude them.
    match /likes/{likeId} {
      function isLikeSender() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      function isLikeSenderCreate() {
        return isSignedIn()
               && request.resource.data.fromUserId == request.auth.uid;
      }

      function isLikeRecipient() {
        return isSignedIn() && request.auth.uid == resource.data.toUserId;
      }

      allow get: if isSignedIn()
                 && (resource == null || isLikeSender() || isLikeRecipient());
      allow list: if isLikeSender() || isLikeRecipient();
      allow create: if isLikeSenderCreate();
      allow update: if false;
      allow delete: if isLikeSender();
    }

    match /skips/{skipId} {
      function isSkipOwner() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      function isSkipOwnerCreate() {
        return isSignedIn()
               && request.resource.data.fromUserId == request.auth.uid;
      }

      allow get: if isSignedIn() && (resource == null || isSkipOwner());
      allow list: if isSkipOwner();
      allow create: if isSkipOwnerCreate();
      allow update: if isSkipOwner();
      allow delete: if isSkipOwner();
    }

    match /discoverSeen/{seenId} {
      function isSeenOwner() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      function isSeenOwnerCreate() {
        return isSignedIn()
               && request.resource.data.fromUserId == request.auth.uid;
      }

      allow read: if isSeenOwner();
      allow create: if isSeenOwnerCreate();
      allow update: if isSeenOwner();
      allow delete: if isSeenOwner();
    }

    match /blocks/{blockId} {
      function isBlocker() {
        return isSignedIn() && request.auth.uid == resource.data.blockerId;
      }

      function isBlockedParty() {
        return isSignedIn()
               && (request.auth.uid == resource.data.blockerId
                   || request.auth.uid == resource.data.blockedId);
      }

      allow read: if isBlockedParty();
      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid;
      allow update: if false;
      allow delete: if isBlocker();
    }

    // Mutual like (W4-02). One doc per pair; id is minUid_maxUid.
    // List queries `userIds array-contains me` — rules must use `in userIds`,
    // not userAId/userBId, or Firestore denies the query.
    match /matches/{matchId} {
      function isMatchParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.userIds;
      }

      function isMatchParticipantCreate() {
        return isSignedIn()
               && (request.auth.uid == request.resource.data.userAId
                   || request.auth.uid == request.resource.data.userBId);
      }

      function validMatchCreate() {
        return request.resource.data.keys().hasOnly(['userAId', 'userBId', 'userIds', 'createdAt'])
               && request.resource.data.userAId is string
               && request.resource.data.userBId is string
               && request.resource.data.userAId < request.resource.data.userBId
               && matchId == request.resource.data.userAId + '_' + request.resource.data.userBId
               && request.resource.data.userIds is list
               && request.resource.data.userIds.size() == 2
               && request.resource.data.userIds.hasAll([
                    request.resource.data.userAId,
                    request.resource.data.userBId
                  ])
               && request.resource.data.createdAt == request.time;
      }

      allow get, list: if isMatchParticipant();
      allow create: if isMatchParticipantCreate() && validMatchCreate();
      allow update, delete: if false;
    }
  }
}
