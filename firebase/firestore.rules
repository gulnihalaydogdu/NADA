rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Complete profiles are readable by any signed-in user for Discover (W3-01).
    // Incomplete profiles stay owner-only. Email is still on the doc — strip client-side.
    match /users/{userId} {
      allow read: if isOwner(userId)
                  || (isSignedIn() && resource.data.isProfileComplete == true);
      allow write: if isOwner(userId);

      // Ordered profile photos (W2-01). Max 6 enforced in client service.
      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // Discovery preferences 1–1 with User (W2-05). Document id == auth uid.
    // Signed-in read lets Discover hydrate buddyTypes on cards; writes stay owner-only.
    match /preferences/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Bits catalog (internal: prompts). Seed via Console; clients read only.
    match /prompts/{promptId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Bit answers (W2-03 / W3-01). Owner writes; any signed-in user can read for Discover.
    match /promptAnswers/{answerId} {
      function isAnswerOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      function isAnswerOwnerCreate() {
        return isSignedIn()
               && request.resource.data.userId == request.auth.uid;
      }

      function validAnswerFields() {
        return request.resource.data.keys().hasAll(['userId', 'promptId', 'answerText', 'sortOrder'])
               && request.resource.data.userId is string
               && request.resource.data.promptId is string
               && request.resource.data.answerText is string
               && request.resource.data.answerText.size() > 0
               && request.resource.data.answerText.size() <= 150
               && request.resource.data.sortOrder is int;
      }

      allow read: if isSignedIn();
      allow create: if isAnswerOwnerCreate() && validAnswerFields();
      allow update: if isAnswerOwner()
                    && request.resource.data.userId == resource.data.userId
                    && validAnswerFields();
      allow delete: if isAnswerOwner();
    }

    // Discover likes (W3-02). Sender writes; sender + recipient can read.
    // `get` on a missing doc needs `resource == null` so createLike's existence check works.
    match /likes/{likeId} {
      function isLikeSender() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      function isLikeSenderCreate() {
        return isSignedIn()
               && request.resource.data.fromUserId == request.auth.uid;
      }

      function isLikeRecipient() {
        return isSignedIn() && request.auth.uid == resource.data.toUserId;
      }

      function validLikeFields() {
        return request.resource.data.keys().hasAll([
                 'fromUserId', 'toUserId', 'targetType', 'targetId', 'createdAt'
               ])
               && request.resource.data.fromUserId is string
               && request.resource.data.toUserId is string
               && request.resource.data.fromUserId != request.resource.data.toUserId
               && request.resource.data.targetType in ['profile', 'prompt', 'photo']
               && request.resource.data.targetId is string
               && request.resource.data.targetId.size() > 0
               && (!('comment' in request.resource.data)
                   || (request.resource.data.comment is string
                       && request.resource.data.comment.size() <= 200));
      }

      allow get: if isSignedIn()
                 && (resource == null || isLikeSender() || isLikeRecipient());
      allow list: if isLikeSender() || isLikeRecipient();
      allow create: if isLikeSenderCreate() && validLikeFields();
      allow update: if false;
      allow delete: if isLikeSender();
    }

    // Discover skips (W3-03). Owner-only.
    // Same missing-doc `get` allowance as likes (undo / duplicate check).
    match /skips/{skipId} {
      function isSkipOwner() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      function isSkipOwnerCreate() {
        return isSignedIn()
               && request.resource.data.fromUserId == request.auth.uid;
      }

      function validSkipFields() {
        return request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'createdAt'])
               && request.resource.data.fromUserId is string
               && request.resource.data.toUserId is string
               && request.resource.data.fromUserId != request.resource.data.toUserId;
      }

      allow get: if isSignedIn() && (resource == null || isSkipOwner());
      allow list: if isSkipOwner();
      allow create: if isSkipOwnerCreate() && validSkipFields();
      allow update: if isSkipOwner() && validSkipFields()
                    && request.resource.data.fromUserId == resource.data.fromUserId
                    && request.resource.data.toUserId == resource.data.toUserId;
      allow delete: if isSkipOwner();
    }
  }
}
