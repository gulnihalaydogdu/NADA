rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Ordered profile photos (W2-01). Max 6 enforced in client service.
      match /photos/{photoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bits catalog (internal: prompts). Seed via Console; clients read only.
    match /prompts/{promptId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bit answers (W2-03). Owner-only; field shape validated on write.
    match /promptAnswers/{answerId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.userId;
      }

      function isOwnerCreate() {
        return request.auth != null
               && request.resource.data.userId == request.auth.uid;
      }

      function validAnswerFields() {
        return request.resource.data.keys().hasAll(['userId', 'promptId', 'answerText', 'sortOrder'])
               && request.resource.data.userId is string
               && request.resource.data.promptId is string
               && request.resource.data.answerText is string
               && request.resource.data.answerText.size() > 0
               && request.resource.data.answerText.size() <= 150
               && request.resource.data.sortOrder is int;
      }

      allow read: if isOwner();
      allow create: if isOwnerCreate() && validAnswerFields();
      allow update: if isOwner()
                    && request.resource.data.userId == resource.data.userId
                    && validAnswerFields();
      allow delete: if isOwner();
    }
  }
}
